<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parichko.Views.AddCategoryPage"
             Title="AddCategory"
             BackgroundColor="#efecec">
    <VerticalStackLayout
        Padding="20, 10, 20, 10">
        <Frame
            Style="{StaticResource AddPageFrame}">
            <VerticalStackLayout>
                <Frame
                    Style="{StaticResource AddEntryFrame}">
                    <Entry
                        Placeholder="Име"
                        x:Name="CatnameEntry"
                        Style="{StaticResource AddEntry}"/>
                </Frame>
                <Frame
                    Style="{StaticResource AddEntryFrame}">
                    <Entry
                        Placeholder="Цвят"
                        x:Name="ColorEntry"
                        Style="{StaticResource AddEntry}"/>
                </Frame>
                <Frame
                    Style="{StaticResource AddEntryFrame}">
                    <Entry
                        Placeholder="Иконка"
                        x:Name="IconEntry"
                        Style="{StaticResource AddEntry}"/>
                </Frame>
                <Button
                    Text="Добави"
                    Style="{StaticResource AddButton}"
                    Clicked="OnAddClicked"/>
            </VerticalStackLayout>
        </Frame>
        <CollectionView ItemsSource="{Binding Categories}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame 
                        Padding="10"
                        Style="{StaticResource EntityFrame}">
                        <Grid
                            ColumnDefinitions="*,*,*"
                            RowDefinitions="*">
                            <Image
                                Grid.Column="0"
                                Source="{Binding IconName}"
                                HeightRequest="100"
                                WidthRequest="100"
                                HorizontalOptions="Start"
                                />
                            <Label 
                                Grid.Column="1"
                                TextColor="Black" 
                                VerticalTextAlignment="Center"
                                Text="{Binding Name}" 
                                FontSize="18" />
                            <Image
                                Grid.Column="2"
                                Source="heartbreak.png"
                                HeightRequest="40"
                                WidthRequest="40"
                                HorizontalOptions="End"
                                Margin="0"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>