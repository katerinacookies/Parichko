<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parichko.Views.AddCategoryPage"
             Title="AddCategory"
             BackgroundColor="#efecec">
    <ScrollView>
        <VerticalStackLayout
        Padding="20, 10, 20, 10">
        <Frame
            Style="{StaticResource AddPageFrame}">
            <VerticalStackLayout>
                <Frame
                    Style="{StaticResource AddEntryFrame}">
                    <Entry
                        Placeholder="Име"
                        x:Name="CatnameEntry"
                        Style="{StaticResource AddEntry}"/>
                </Frame>
                <Frame
                    Style="{StaticResource AddEntryFrame}">
                    <Entry
                        Placeholder="Цвят"
                        x:Name="ColorEntry"
                        Style="{StaticResource AddEntry}"/>
                </Frame>
                <Button 
                        Text="Иконка"
                        TextColor="{StaticResource Primary}" 
                        Clicked="OpenPicker"
                        BackgroundColor="White"
                        CornerRadius="30"
                        HeightRequest="50"/>

                <Frame
                    x:Name="CategoryIcons"
                    Padding="0"
                    IsVisible="False"
                    BackgroundColor="Transparent"
                    BorderColor="Transparent">
                    <Grid
                        ColumnDefinitions="*,*,*,*"
                        RowDefinitions="*,*,*,*,*">
                            <Button
                                Grid.Column="0"
                                Grid.Row="0"
                                ImageSource="foodcat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="1"
                                Grid.Row="0"
                                ImageSource="teacat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="2"
                                Grid.Row="0"
                                ImageSource="groceriescat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="3"
                                Grid.Row="0"
                                ImageSource="cleancat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="0"
                                Grid.Row="1"
                                ImageSource="medscat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="1"
                                Grid.Row="1"
                                ImageSource="presentscat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="2"
                                Grid.Row="1"
                                ImageSource="nailscat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="3"
                                Grid.Row="1"
                                ImageSource="ticketscat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="0"
                                Grid.Row="2"
                                ImageSource="bookscat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="1"
                                Grid.Row="2"
                                ImageSource="schoolcat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="2"
                                Grid.Row="2"
                                ImageSource="petcat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="3"
                                Grid.Row="2"
                                ImageSource="sportscat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="0"
                                Grid.Row="3"
                                ImageSource="techcat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="1"
                                Grid.Row="3"
                                ImageSource="transportcat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="2"
                                Grid.Row="3"
                                ImageSource="clothescat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="3"
                                Grid.Row="3"
                                ImageSource="wificat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="0"
                                Grid.Row="4"
                                ImageSource="babycat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="1"
                                Grid.Row="4"
                                ImageSource="jewelscat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="2"
                                Grid.Row="4"
                                ImageSource="underwearcat.png"
                                Style="{DynamicResource CatButton}"
                                />
                            <Button
                                Grid.Column="3"
                                Grid.Row="4"
                                ImageSource="otherscat.png"
                                Style="{DynamicResource CatButton}"
                                />
                        </Grid>
                </Frame>
                
                <Button
                    Text="Добави"
                    Style="{StaticResource AddButton}"
                    Clicked="OnAddClicked"/>
            </VerticalStackLayout>
        </Frame>
        <CollectionView ItemsSource="{Binding Categories}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame 
                        Padding="10"
                        Style="{StaticResource EntityFrame}">
                        <Grid
                            ColumnDefinitions="*,*,*"
                            RowDefinitions="*">
                            <Image
                                Grid.Column="0"
                                Source="{Binding IconName}"
                                HeightRequest="100"
                                WidthRequest="100"
                                HorizontalOptions="Start"
                                />
                            <Label 
                                Grid.Column="1"
                                TextColor="Black" 
                                VerticalTextAlignment="Center"
                                Text="{Binding Name}" 
                                FontSize="18" />
                            <Image
                                Grid.Column="2"
                                Source="heartbreak.png"
                                HeightRequest="40"
                                WidthRequest="40"
                                HorizontalOptions="End"
                                Margin="0"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
    </ScrollView>
</ContentPage>