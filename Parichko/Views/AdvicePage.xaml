<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parichko.Views.AdvicePage"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             Shell.NavBarIsVisible="False"
             Title="AdvicePage">
    <ScrollView>
        <VerticalStackLayout
            Padding="25">
            <Grid
                RowDefinitions="*"
                ColumnDefinitions="*,*">
                <Label
                    Grid.Column="0"
                    Text="Ноември"/>
                <Label
                    Grid.Column="1"
                    Text=""
                    HorizontalTextAlignment="End"/>
            </Grid>
            <Frame
                BorderColor="Transparent"
                BackgroundColor="#ffdbe8"
                HeightRequest="250"
                CornerRadius="30"
                Margin="0, 20">
                <chart:SfCircularChart>
                    <chart:SfCircularChart.Legend>
                        <chart:ChartLegend IsVisible="True"/>
                    </chart:SfCircularChart.Legend>
                    <chart:SfCircularChart.Series>
                        <chart:DoughnutSeries
                            ItemsSource="{Binding CategoryExpenseData}"
                            InnerRadius="0.4"
                            XBindingPath="CategoryName"
                            YBindingPath="TotalExpense"
                            ShowDataLabels="True"
                            PaletteBrushes="{Binding CustomBrushes}">

                            <chart:DoughnutSeries.DataLabelSettings>
                                <chart:CircularDataLabelSettings 
                                    LabelPosition="Inside" 
                                    UseSeriesPalette="True"/>
                            </chart:DoughnutSeries.DataLabelSettings>

                        </chart:DoughnutSeries>
                    </chart:SfCircularChart.Series>
                </chart:SfCircularChart>

            </Frame>
            <Label
                Text="Съветът на Паричко"/>
            <Frame
                BorderColor="Transparent"
                BackgroundColor="{StaticResource Cutesyblue}"
                Padding="10"
                CornerRadius="20"
                Margin="0, 10">
                <Grid
                    ColumnDefinitions="*,*">
                    <Image
                        Grid.Column="0"
                        Source="parichkoadvice.png"
                        HeightRequest="40"
                        WidthRequest="40"
                        HorizontalOptions="Start"/>
                    <Label
                        Grid.Column="1"
                        HorizontalTextAlignment="Start"
                        Text="Опитай да ограничиш разходите си за козметика."/>
                </Grid>
            </Frame>
            <Frame
                BorderColor="Transparent"
                BackgroundColor="#ffdbe8"
                CornerRadius="30"
                HeightRequest="300"
                Margin="0, 10">
                <VerticalStackLayout>
                    <Label
                    Text="Приходи и разходи за месеца"/>
                </VerticalStackLayout>
            </Frame>

            <Frame>
                <Grid
                RowDefinitions="*,*"
                ColumnDefinitions="*,*">

                </Grid>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>