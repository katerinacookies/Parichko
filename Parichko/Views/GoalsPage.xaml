<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parichko.Views.GoalsPage"
             Shell.NavBarIsVisible="False"
             Title="GoalsPage">
    <ScrollView>
        <VerticalStackLayout
        Padding="25, 30, 25, 10">
            <Label 
                Text="Твоите цели"
                VerticalOptions="Center" 
                HorizontalOptions="Start"
                TextColor="{StaticResource PrimaryDarkText}"
                FontAttributes="Bold"
                Style="{StaticResource SubHeadline}"/>
            <ScrollView>
                <CollectionView ItemsSource="{Binding Goals}"
                            HeightRequest="600">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame
                            BackgroundColor="{StaticResource Cutesyblue}"
                            BorderColor="Transparent"
                            HeightRequest="180"
                            CornerRadius="30"
                            Margin="0, 10">
                                <VerticalStackLayout>
                                    <Grid
                                RowDefinitions="*,*,*"
                                ColumnDefinitions="*,*,*,*">
                                        <Image
                                    Source="{Binding IconName}"
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    HeightRequest="40"
                                    WidthRequest="40"
                                    HorizontalOptions="Start"/>
                                        <Label
                                            Text="{Binding Name}"
                                            Grid.Column="1"
                                            Grid.Row="0"
                                            FontSize="18"
                                            FontAttributes="Bold"/>
                                        <Label
                                            Text="{Binding GoalAmount}"
                                            Grid.Column="3"
                                            Grid.Row="0"
                                            FontSize="18"
                                            HorizontalTextAlignment="End"
                                            FontAttributes="Bold"/>
                                        <Label
                                    Text="Спестени средства"
                                    Grid.Column="0"
                                    Grid.Row="1"/>
                                        <Label
                                    Text="{Binding SavedAmount}"
                                    Grid.Row="1"
                                    Grid.Column="1"/>
                                        <Frame
                                            Grid.Row="2"
                                            WidthRequest="200"
                                            Padding="0"
                                            HorizontalOptions="Start"
                                            BackgroundColor="Transparent"
                                            BorderColor="Transparent">
                                            <Entry
                                                x:Name="AddedAmountEntry"
                                                x:Uid="AddedAmountEntry"
                                                WidthRequest="200"
                                                Placeholder="Добави спестяване"
                                                PlaceholderColor="Black"
                                                TextColor="Black"
                                                HorizontalOptions="Start"/>
                                        </Frame>
                                        <Button
                                            Grid.Column="3"
                                            Grid.Row="2"
                                            ImageSource="addtogoal.png"
                                            HeightRequest="50"
                                            HorizontalOptions="End"
                                            
                                            Clicked="OnAddProgressClicked"
                                            BackgroundColor="Transparent"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
            <Grid
            ColumnDefinitions="*,*"
            RowDefinitions="*">
                <Label
                Grid.Column="0"
                Text="Приятели"
                    FontSize="18"
                    FontAttributes="Bold"/>
                <Button
                Grid.Column="1"
                Text="Виж всички"
                TextColor="Grey"
                HorizontalOptions="End"
                BackgroundColor="Transparent"
                Padding="0"/>
            </Grid>

            <Frame
            HeightRequest="90"
            BackgroundColor="Transparent"
            BorderColor="Transparent"
            Padding="10">
                <HorizontalStackLayout>
                    <CollectionView ItemsSource="{Binding Friends}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    RowDefinitions="*,*">
                                    <Image
                                        Grid.Row="0"
                                        Source="heartbreak.png"
                                        HeightRequest="40"
                                        WidthRequest="40"/>
                                    <Label
                                        Grid.Row="1"
                                        HorizontalTextAlignment="Center"
                                        FontSize="18"
                                        Margin="0, 5, 0, 0"
                                        Text="{Binding DisplayName}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </HorizontalStackLayout>
            </Frame>
            <!--
            <Label
            Text="Съветът на Паричко"/>
            <Frame
            BackgroundColor="#ffdbe8"
            BorderColor="Transparent"
            Padding="10"
            Margin="0, 10">
                <HorizontalStackLayout>
                    <Image
                    Source="parichkoadvice.png"
                    HeightRequest="40"
                    WidthRequest="40"/>
                    <Label
                    Text="Важно е да спестяваш по малка сума пари всеки ден."/>
                </HorizontalStackLayout>
            </Frame>-->

            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>