<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parichko.Views.AddExpensePage"
             Title="AddExpensePage">
    <VerticalStackLayout
        Padding="20, 10, 20, 10">
        <Frame
            Style="{StaticResource AddPageFrame}">
            <VerticalStackLayout>
                <Frame
                    Style="{StaticResource AddEntryFrame}">
                    <Entry
                        Placeholder="Име"
                        x:Name="ExpensenameEntry"
                        Style="{StaticResource AddEntry}"
                        />
                </Frame>
                <Frame
                    Style="{StaticResource AddEntryFrame}">
                    <Entry
                        Placeholder="Стойност"
                        x:Name="ExpenseAmountEntry"
                        Style="{StaticResource AddEntry}"/>
                </Frame>
                <!--<Picker
                    x:Name="CategoryDropdown"
                    Title="Категория">
                    
                </Picker>-->
                <CollectionView 
                    x:Name="categoryDropdown"
                    IsVisible="False"
                    SelectionMode="Single"
                    
                    Margin="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame
                                >
                                <Label
                                    Text="{Binding}"/>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <Button
                    Text="Добави"
                    Style="{StaticResource AddButton}"
                    Clicked="OnAddClicked"/>
            </VerticalStackLayout>
        </Frame>
        <CollectionView ItemsSource="{Binding Expenses}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" CornerRadius="10">
                        <StackLayout>
                            <Label TextColor="Black" Text="{Binding Name}" FontSize="14" />
                            <Label TextColor="Black" Text="{Binding Amount}" FontSize="14" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>