<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parichko.Views.AddExpensePage"
             Title="AddExpensePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#efecec">
    
    <VerticalStackLayout
        Padding="20, 10, 20, 10">
        
            <Frame
            Style="{StaticResource AddPageFrame}">
                <VerticalStackLayout>
                    <Frame
                    Style="{StaticResource AddEntryFrame}">
                        <Entry
                        Placeholder="Име"
                        x:Name="ExpensenameEntry"
                        Style="{StaticResource AddEntry}"
                        />
                    </Frame>
                    <Frame
                    Style="{StaticResource AddEntryFrame}">
                        <Entry
                        Placeholder="Стойност"
                        x:Name="ExpenseAmountEntry"
                        Style="{StaticResource AddEntry}"/>
                    </Frame>

                    <!-- Бутон за падащо меню
                Text="{Binding SelectedItemName}" -->
                    <Button 
                        Text="Категория"
                        TextColor="{StaticResource Primary}" 
                        BackgroundColor="White" 
                        Clicked="OpenPicker"
                        Padding="10" 
                        CornerRadius="20"
                        HeightRequest="50"/>

                    <!-- Modal view, който играе ролята на падащо меню -->
                    <!--<ContentView 
                    x:Name="CategoriesView" 
                    IsVisible="False"
                    BackgroundColor="#88000000" Padding="20">
                    
                        <CollectionView 
                            x:Name="CategoriesDropdown"
                            
                            SelectionMode="Single" 
                            SelectionChanged="OnItemSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>

                                    <StackLayout Orientation="Horizontal" Padding="0">
                                        
                                        <Label Text="bazinga" 
                                               TextColor="Pink"
                                               VerticalOptions="Center"
                                               Margin="0,0,0,0"/>
                                    </StackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    
                </ContentView>>-->

                    <CollectionView 
                        x:Name="categoryDropdown"
                        IsVisible="False"
                        SelectionMode="Single"
                        SelectionChanged="OnItemSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                            <Label
                                    Text="{Binding Name}"
                                    TextColor="{StaticResource Primary}"
                                    x:Name="CatLabel"
                                    BackgroundColor="White"
                                    HeightRequest="40"
                                    Margin="0, 10, 0, 0"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"/>
                        </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button
                    Text="Добави"
                    Style="{StaticResource AddButton}"
                    Clicked="OnAddClicked"/>
                </VerticalStackLayout>
            </Frame>
        <ScrollView>
            <CollectionView 
                ItemsSource="{Binding Expenses}"
                HeightRequest="370">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame 
                            Padding="20, 10" 
                            Margin="0, 15, 0, 0" 
                            CornerRadius="30"
                            BorderColor="{Binding Category.Color}">
                            <StackLayout>
                            <Grid
                                ColumnDefinitions="*,*,*,*"
                                RowDefinitions="*">
                                <Image
                                    Grid.Column="0"
                                    Source="{Binding Category.IconName}"
                                    HeightRequest="40"
                                    HorizontalOptions="Start"/>
                                <Label 
                                    Grid.Column="1"
                                    TextColor="Black" 
                                    Text="{Binding Name}" 
                                    FontSize="18"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"/>
                                <!--<Label
                                    Grid.Column="1"
                                    Grid.Row="1"
                                    TextColor="Black"
                                    Text="{Binding Date}"/>-->
                                <Label 
                                    Grid.Column="2"
                                    TextColor="Black" 
                                    Text="{Binding Amount}" 
                                    FontSize="18"
                                    HorizontalTextAlignment="End"
                                    VerticalTextAlignment="Center"/>
                                <Button
                                    Grid.Column="3"
                                    ImageSource="heartbreak.png"
                                    HeightRequest="50"
                                    Margin="0"
                                    HorizontalOptions="End"
                                    BackgroundColor="Transparent"
                                    Clicked="OnDeleteClicked"/>
                            </Grid>
                        </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>