<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parichko.Views.HomePage" 
             Shell.FlyoutItemIsVisible="False"
             Title="HomePage"
             >
    <VerticalStackLayout
        Padding="30">
        <Label 
            x:Name="displayhi"
            x:Uid="displayhi"
            VerticalOptions="Center" 
            HorizontalOptions="Start"
            TextColor="{StaticResource PrimaryDarkText}"
            FontAttributes="Bold"
            Style="{StaticResource SubHeadline}"/>

        <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
            <!--Лява половина-->
            <Frame
                Grid.Column="0"
                Grid.RowSpan="2"
                BackgroundColor="LightPink"
                CornerRadius="20"
                Padding="20"
                Margin="0, 20, 5, 10">
                
            </Frame>
            <!--Дясна половина-->
            <Frame
                Grid.Column="1"
                Grid.Row="0"
                BackgroundColor="LightBlue"
                CornerRadius="10"
                Padding="20"
                Margin="5, 20, 0, 5">
                
            </Frame>
            <Frame
                Grid.Column="1"
                Grid.Row="1"
                BackgroundColor="LightSalmon"
                CornerRadius="10"
                Padding="20"
                Margin="5, 5, 0, 10">
                
            </Frame>
        </Grid>
    </VerticalStackLayout>
</ContentPage>