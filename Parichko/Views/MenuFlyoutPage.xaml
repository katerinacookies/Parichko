<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parichko.Views.MenuFlyoutPage"
             Title="MenuFlyoutPage">
    
    <FlyoutPage.Flyout>
        <ContentPage Title="Menu">
            <StackLayout>
                <Button Text="Home" Clicked="GoToHome"/>
                <Button Text="Profile" Clicked="GoToProfile"/>
            </StackLayout>
        </ContentPage>
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <ContentPage>
            <Label Text="Welcome to Home!" VerticalOptions="Center" HorizontalOptions="Center"/>
        </ContentPage>
    </FlyoutPage.Detail>
</FlyoutPage>